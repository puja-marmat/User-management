# Copy to .env and fill in. .env is git-ignored and must never be committed or pasted in chat.

# local | dev | uat | prod | test
ENVIRONMENT=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=true

# ── SQL Server: sav_uat (plan §4.1, DEC-32: one login for everything in phase 1) ────────
# Format:
#   mssql+aioodbc://<user>:<url-encoded password>@<host>:<port>/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# - URL-encode special characters in the password (@ -> %40, # -> %23, % -> %25, : -> %3A, / -> %2F).
# - From Docker on the same PC as SQL Server, use host.docker.internal instead of localhost.
# - Named instance: host%5CINSTANCE (\ encoded) and omit the port, or use the instance's fixed port.
# - TrustServerCertificate=yes only while the server uses a self-signed certificate.
DB_WRITER_URL=mssql+aioodbc://USER:PASSWORD@HOST:1433/sav_uat?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# Optional; default to DB_WRITER_URL when empty.
DB_READER_URL=
DB_MIGRATION_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ── Phase 1 guard (00a §0.1): keep false. Alembic/migrate refuse to run unless true. ──
IAM_MIGRATIONS_ENABLED=false

# ── MasterDb routing (U01 DEC-44): legacy logic, stored in a local CSV, no MasterDb connection ──
# off | file | live   (live is not available in Phase 1 and stops the app)
MASTERDB_MODE=file
# Relative to the project folder (Docker: mounted at /app/data). Created on first write.
MASTERDB_FILE_PATH=data/masterdb-routing.csv
MASTERDB_LOCK_TIMEOUT_SECONDS=10
# Non-secret values copied from the UAT cp-web appSettings (legacy key in brackets).
# Leave a line out to mimic a missing key; legacy behaviour differs for missing vs empty.
MASTERDB_API_BASE_URL=<value of ApiBaseurl>
MASTERDB_PAYMENT_URL=<value of PaymentUrl>
# Comma/semicolon separated site ids routed to PayU
PAYU_SITE_IDS=<value of PayUSiteId>

# ── Parity harness (python -m app.parity): any long random local value ──
PARITY_HASH_KEY=

# ── Authentication (P1-M2) ───────────────────────────────────────────────────────────────
# ENVIRONMENT=local/test: leave both empty → keys generated at start-up (everyone is signed out
# on restart). Any other ENVIRONMENT: both required (see docs/UAT-P1-M2.md to generate them).
# RSA private key, PEM, on ONE line with \n for line breaks, in double quotes.
JWT_PRIVATE_KEY_PEM=
# At least 32 random bytes (e.g. 64 hex characters).
OTP_SIGNING_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
OTP_TTL_MINUTES=10
RESET_TICKET_TTL_MINUTES=10
# Sender written to AlertQueues.FromAddress (legacy appSetting CustomerSupportEmail).
ALERT_FROM_ADDRESS=<value of CustomerSupportEmail>

# JSON list
CORS_ORIGINS=["http://localhost:5173"]

# Only for the optional local SQL Server container (docker compose --profile localdb)
LOCAL_MSSQL_SA_PASSWORD=
